---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { cv } from "../lib/cv";

const projects = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: cv.profile.name,
  url: "https://mek.dev",
  jobTitle: "Digital Lab Lead",
  worksFor: { "@type": "Organization", name: "Turkish Technology" },
  address: { "@type": "PostalAddress", addressLocality: "Istanbul", addressCountry: "TR" },
  sameAs: [
    "https://github.com/ekremkenter",
    "https://linkedin.com/in/ekremkenter",
    "https://twitter.com/ekremkenter",
    "https://medium.com/@ekremkenter",
  ],
};
---

<Base
  title="Mustafa Ekrem KENTER"
  description="Digital Lab Lead at Turkish Technology. Making airlines chat-native with MCP & agentic AI. Chatbots since 2018, LLM products since 2023, enterprise MCP in production today."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <section class="max-w-3xl mx-auto px-6 pt-16 sm:pt-24">
    <p class="eyebrow reveal reveal-1">IST · Digital Lab Lead @ Turkish Technology</p>
    <h1 class="reveal reveal-2 mt-4 text-4xl sm:text-6xl font-bold leading-[1.05] tracking-tight">
      Making airlines<br />
      <span class="text-accent-strong">chat-native.</span>
    </h1>
    <p class="reveal reveal-3 mt-6 text-lg text-soft max-w-xl leading-relaxed">
      I'm Ekrem. I built one of the world's first enterprise MCP platforms —
      Turkish Airlines is live inside both Claude and ChatGPT, and was the
      first airline in Anthropic's connector directory. Chatbots since 2018,
      LLM products since 2023. Founder instincts inside a 100M-passenger
      airline.
    </p>
    <div class="reveal reveal-4 mt-8 flex flex-wrap items-center gap-4">
      <a
        href="https://cal.com/ekremkenter/15min"
        target="_blank"
        rel="noopener"
        class="px-5 py-2.5 rounded-md bg-accent text-white dark:text-[#0e1514] font-medium hover:bg-accent-strong transition-colors"
        >Let’s talk →</a
      >
      <a href="/about" class="link text-sm">More about me</a>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 mt-20 sm:mt-28">
    <p class="eyebrow">Selected work</p>
    <div class="mt-5 grid gap-4">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
    <a href="/projects" class="link inline-block mt-5 text-sm">All projects →</a>
  </section>

  <section class="max-w-3xl mx-auto px-6 mt-20 sm:mt-28">
    <p class="eyebrow">Writing</p>
    <ul class="mt-5 divide-y divide-line border-y border-line">
      {
        posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}`}
              class="group flex items-baseline justify-between gap-4 py-4"
            >
              <span class="font-medium group-hover:text-accent-strong transition-colors">
                {post.data.title}
              </span>
              <time
                class="font-mono text-xs text-faint shrink-0"
                datetime={post.data.date.toISOString()}
              >
                {post.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
