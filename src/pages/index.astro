---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import AskChat from "../components/AskChat.astro";
import PostFeature from "../components/PostFeature.astro";
import WorkCard from "../components/WorkCard.astro";
import { cv } from "../lib/cv";
import narrations from "../data/narration.json";
import profile from "../assets/profile.jpeg";
import { workShots } from "../lib/work-shots";

const featured = (await getCollection("projects"))
  .filter((p) => p.data.featured && !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

// the projects with something to show get a picture; the rest are listed
const shown = featured.filter((p) => workShots[p.id]);
const listed = featured.filter((p) => !workShots[p.id]);

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [latest, ...older] = posts.slice(0, 4);

const listenMinutes = (id: string) => {
  const n = (narrations as Record<string, { seconds: number }>)[id];
  return n ? Math.max(1, Math.round(n.seconds / 60)) : undefined;
};
const day = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
const month = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", { year: "numeric", month: "short", timeZone: "UTC" });
const kindLabel = { essay: "Essay", note: "Note", report: "Report" } as const;

const talks = cv.speaking
  .filter((s) => s.title && s.date)
  .sort((a, b) => (b.date ?? "").localeCompare(a.date ?? ""));

// each claim links to where it is backed up
const proof = [
  {
    claim: "The first airline in Claude's connector directory.",
    detail: "Turkish Airlines, on the MCP platform my team built.",
    href: "/blog/one-backend-every-ai-agent/",
    link: "How it happened",
  },
  {
    claim: "Over two million conversations in 2026, in 100+ languages.",
    detail: "TKAssistant, as announced by Turkish Airlines' CEO.",
    href: "/projects/tkassistant/",
    link: "About the assistant",
  },
  {
    claim: "Keynote at Future of Aviation 2026, Helsinki.",
    detail: "“Chat Is the New Booking Engine.”",
    href: "/blog/chat-is-the-new-booking-engine/",
    link: "Read the talk",
  },
];

const questions = [
  "What does Ekrem do?",
  "What is MCP, in his words?",
  "Which talks has he given?",
  "How do I book a call with him?",
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://mek.dev/#person",
  name: "Mustafa Ekrem Kenter",
  url: "https://mek.dev",
  jobTitle: "Digital Lab Lead",
  worksFor: { "@type": "Organization", name: "Turkish Technology" },
  address: { "@type": "PostalAddress", addressLocality: "Istanbul", addressCountry: "TR" },
  sameAs: [
    `https://github.com/${cv.profile.social.github}`,
    `https://linkedin.com/in/${cv.profile.social.linkedin}`,
    `https://www.youtube.com/${cv.profile.social.youtube}`,
    `https://twitter.com/${cv.profile.social.twitter}`,
    `https://medium.com/${cv.profile.social.medium}`,
  ],
};
---

<Base
  title="Mustafa Ekrem Kenter"
  description="Digital Lab Lead at Turkish Technology. Software craftsman who taught machines to talk and now teaches them to act. Turkish Airlines lives inside Claude and ChatGPT, built by his team."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <section class="max-w-5xl mx-auto px-6 pt-10 sm:pt-16">
    <div class="grid gap-x-14 gap-y-8 lg:grid-cols-[minmax(0,1fr)_17rem] lg:items-end">
      <div>
        <h1 class="reveal reveal-1 text-[clamp(1.5rem,7vw,2rem)] sm:text-5xl lg:text-[3.25rem] font-bold leading-[1.1] tracking-tight">
          Software craftsman.
          <span class="block text-accent-strong">
            <span class="block text-balance">Taught machines to talk,</span>
            <span class="block text-balance">now teaching them to act.</span>
          </span>
        </h1>
        <p class="reveal reveal-2 mt-6 text-lg text-soft max-w-[38rem] leading-relaxed">
          Seventeen years building software, the last eight teaching it to talk and, lately, to act. Turkish Airlines'
          chatbot in 2018, an LLM support product in 2023, and today one of the world's first enterprise MCP platforms,
          live inside Claude and ChatGPT. I lead the Digital Lab at Turkish Technology: the scout boat ahead of a very
          big ship. Father of two.
        </p>
        <p class="reveal reveal-2 mt-5 flex flex-wrap gap-x-6 gap-y-2">
          <a href="/about/" class="link">More about me</a>
          <a href={cv.profile.booking} target="_blank" rel="noopener" class="link">Book a 15-minute call</a>
        </p>
      </div>

      <figure class="home-portrait reveal reveal-2 order-first lg:order-none">
        <Image
          src={profile}
          alt="Portrait of Mustafa Ekrem Kenter"
          widths={[144, 272, 544]}
          sizes="(min-width: 1024px) 272px, 72px"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          <strong>Mustafa Ekrem Kenter</strong>
          <span>Digital Lab Lead, Turkish Technology</span>
          <span>Istanbul</span>
        </figcaption>
      </figure>
    </div>

    <AskChat
      variant="panel"
      class="reveal reveal-3 mt-10 sm:mt-14"
      suggestions={questions}
      placeholder="Ask about my work…"
    >
      <div slot="intro" class="ask-greeting">
        <p class="ask-speaker">mek.dev</p>
        <p>
          This site answers questions. Ask about my work, writing or talks. It answers from what's published here,
          and shows you each time it looks something up.
        </p>
      </div>
      <Fragment slot="note">
        An AI agent (Claude Haiku) answers, only from what's published here. It can still get things wrong, so follow
        the links. Questions aren't stored. <a href="/ask/#mcp">Use these tools from your own agent</a>.
      </Fragment>
    </AskChat>
  </section>

  <section class="max-w-5xl mx-auto px-6 mt-14 sm:mt-20" aria-label="Highlights">
    <ul class="home-proof">
      {
        proof.map((p) => (
          <li>
            <p class="home-proof-claim">{p.claim}</p>
            <p class="mt-2 text-sm text-soft">
              {p.detail}{" "}
              <a href={p.href} class="link whitespace-nowrap">
                {p.link}
              </a>
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="max-w-5xl mx-auto px-6 mt-20 sm:mt-28">
    <div class="home-heading">
      <h2>Selected work</h2>
      <a href="/projects/" class="link">All projects</a>
    </div>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {shown.map((p) => <WorkCard project={p} />)}
    </div>
    {
      listed.length > 0 && (
        <ul class="mt-6 divide-y divide-line border-y border-line">
          {listed.map((p) => (
            <li>
              <a
                href={p.data.href ?? `/projects/${p.id}/`}
                class="group grid gap-x-8 gap-y-1 py-4 sm:grid-cols-[16rem_minmax(0,1fr)_auto] sm:items-baseline"
              >
                <span class="font-semibold group-hover:text-accent-strong transition-colors">{p.data.title}</span>
                <span class="text-sm text-soft">{p.data.summary}</span>
                <span class="font-mono text-xs text-faint">{p.data.period}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="max-w-5xl mx-auto px-6 mt-20 sm:mt-28">
    <div class="home-heading">
      <h2>Latest writing</h2>
      <a href="/blog/" class="link">All writing</a>
    </div>
    <div class="mt-6 grid gap-x-12 gap-y-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
      <PostFeature post={latest} />
      <ul class="divide-y divide-line border-y border-line self-start">
        {
          older.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`} class="group block py-5">
                <p class="text-sm text-faint">
                  {kindLabel[post.data.kind]},{" "}
                  <time datetime={post.data.date.toISOString()}>{day(post.data.date)}</time>
                  {listenMinutes(post.id) && (
                    <span class="listen-badge ml-3">Listen · {listenMinutes(post.id)} min</span>
                  )}
                </p>
                <h3 class="mt-1 text-lg font-semibold leading-snug group-hover:text-accent-strong transition-colors">
                  {post.data.title}
                </h3>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 mt-20 sm:mt-28">
    <div class="page-split">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold">On stage</h2>
        <p class="mt-3 text-soft">Most of my thinking happens on stage first. The essays are the written form.</p>
      </div>
      <ul class="divide-y divide-line border-y border-line">
        {
          talks.map((t) => {
            const href = t.essay ? `${t.essay}/` : t.link;
            const where = [t.kind, t.event, t.location].filter(Boolean).join(", ");
            return (
              <li class="grid gap-x-8 gap-y-1 py-4 sm:grid-cols-[6.5rem_minmax(0,1fr)]">
                <time class="font-mono text-xs text-faint sm:pt-1" datetime={t.date}>
                  {month(t.date!)}
                </time>
                <div>
                  {href ? (
                    <a
                      href={href}
                      class="font-semibold hover:text-accent-strong transition-colors"
                      target={href.startsWith("/") ? undefined : "_blank"}
                      rel={href.startsWith("/") ? undefined : "noopener"}
                    >
                      {t.title}
                    </a>
                  ) : (
                    <span class="font-semibold">{t.title}</span>
                  )}
                  <p class="text-sm text-soft">{where}</p>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 mt-20 sm:mt-28">
    <div class="home-invite">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold">Working on agentic AI, MCP or airline retailing?</h2>
        <p class="mt-3 text-soft max-w-xl">
          I take a small number of advisory conversations and speaking invitations.
        </p>
      </div>
      <a
        href={cv.profile.booking}
        target="_blank"
        rel="noopener"
        class="shrink-0 px-6 py-3 rounded-lg bg-accent text-white dark:text-bg font-semibold hover:bg-accent-strong transition-colors"
        >Book 15 minutes</a
      >
    </div>
  </section>
</Base>
