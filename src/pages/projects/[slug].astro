---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  // entries with an href override (evrad landing, palestine tool) have no detail page
  return projects
    .filter((p) => !p.data.href)
    .map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Base
  title={`${project.data.title} · Mustafa Ekrem Kenter`}
  description={project.data.summary}
>
  <article class="max-w-3xl mx-auto px-6 pt-14">
    <p class="eyebrow">{project.data.period} · {project.data.org}</p>
    <h1 class="mt-3 text-3xl sm:text-4xl font-bold">{project.data.title}</h1>
    <p class="mt-3 text-soft">{project.data.role}</p>
    <p class="mt-4 font-mono text-[0.7rem] tracking-wide text-faint uppercase">
      {project.data.stack.join(" · ")}
    </p>
    <div class="prose-mek mt-8">
      <Content />
    </div>
    <p class="mt-12">
      <a href="/projects/" class="link text-sm">← All projects</a>
    </p>
  </article>
</Base>
