---
import Base from "../../../layouts/Base.astro";
---

<Base
  title="Evrad-ı Şerif Uygulaması"
  description="Mehmed Zahid Kotku Hz.'nin Evrad-ı Şerifi — iOS ve Android uygulaması."
  lang="tr"
>
  <section
    class="max-w-4xl mx-auto px-6 pt-14 flex flex-col md:flex-row items-center gap-10 md:gap-16"
  >
    <img
      src="/assets/evrad/evrad.png"
      alt="Evrad-ı Şerif Uygulaması ekran görüntüsü"
      width="280"
      height="560"
      class="w-56 sm:w-64 rounded-[2rem] border border-line shadow-xl shrink-0"
    />
    <div>
      <h1 class="text-4xl font-bold">Evrad-ı Şerif</h1>
      <p class="mt-4 text-soft leading-relaxed">
        Mehmed Zahid Kotku Hz.’nin Evrad-ı Şerifi olan, Gümüş Ev Yayıncılık'ın
        bastığı kitaptan alınan içerikle hazırlanan bu uygulamada,
        Peygamberlerin ve İslam büyüklerinin virdlerini, birçok duayı ve
        tesbihatı bulabileceksiniz. Numan b. Beşir (r.a.), Resûlüllah
        (aleyhi’s-salâtü vesselâm)’ın şöyle buyurduğunu söylemiştir: “Dua
        ibadettir. Allah-u Teâlâ: ‘Dua edin kabul edeyim’, buyurmuştur.”
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="https://itunes.apple.com/app/id1445156190?mt=8"
          target="_blank"
          rel="noopener"
          aria-label="App Store'dan indirin"
          class="flex w-44 h-13 px-4 py-2.5 bg-black text-white rounded-xl items-center gap-3"
        >
          <svg viewBox="0 0 384 512" width="24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"
            ></path>
          </svg>
          <span class="leading-tight">
            <span class="block text-[0.6rem]">Download on the</span>
            <span class="block text-lg font-semibold -mt-0.5">App Store</span>
          </span>
        </a>
        <a
          href="https://play.google.com/store/apps/details?id=tr.com.navek.evrad"
          target="_blank"
          rel="noopener"
          aria-label="Google Play'den alın"
          class="flex w-44 h-13 px-4 py-2.5 bg-black text-white rounded-xl items-center gap-3"
        >
          <svg viewBox="30 336.7 120.9 129.2" width="24" aria-hidden="true">
            <path
              fill="#FFD400"
              d="M119.2,421.2c15.3-8.4,27-14.8,28-15.3c3.2-1.7,6.5-6.2,0-9.7c-2.1-1.1-13.4-7.3-28-15.3l-20.1,20.2L119.2,421.2z"
            ></path>
            <path
              fill="#FF3333"
              d="M99.1,401.1l-64.2,64.7c1.5,0.2,3.2-0.2,5.2-1.3c4.2-2.3,48.8-26.7,79.1-43.3L99.1,401.1L99.1,401.1z"
            ></path>
            <path
              fill="#48FF48"
              d="M99.1,401.1l20.1-20.2c0,0-74.6-40.7-79.1-43.1c-1.7-1-3.6-1.3-5.3-1L99.1,401.1z"
            ></path>
            <path
              fill="#3BCCFF"
              d="M99.1,401.1l-64.3-64.3c-2.6,0.6-4.8,2.9-4.8,7.6c0,7.5,0,107.5,0,113.8c0,4.3,1.7,7.4,4.9,7.7L99.1,401.1z"
            ></path>
          </svg>
          <span class="leading-tight">
            <span class="block text-[0.6rem]">GET IT ON</span>
            <span class="block text-lg font-semibold -mt-0.5">Google Play</span>
          </span>
        </a>
      </div>
      <p class="mt-6">
        <a href="/projects/evrad/privacy" class="link text-xs">Gizlilik Politikası</a>
      </p>
    </div>
  </section>
</Base>
