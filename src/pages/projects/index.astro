---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import WorkCard from "../../components/WorkCard.astro";
import { workShots } from "../../lib/work-shots";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
// projects with a screenshot lead; the rest follow as a grid
const shown = projects.filter((p) => workShots[p.id]);
const others = projects.filter((p) => !workShots[p.id]);
---

<Base
  title="Projects · Mustafa Ekrem Kenter"
  description="Selected work: enterprise MCP for airlines, chatbots, LLM products, and long-running side projects."
>
  <section class="max-w-5xl mx-auto px-6 pt-10 sm:pt-16">
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">Things that shipped.</h1>
    <p class="mt-4 text-lg text-soft max-w-xl">
      From an airline inside Claude and ChatGPT to a book app that has run quietly since 2019.
    </p>
    <div class="mt-10 sm:mt-14 grid gap-6 md:grid-cols-2">
      {shown.map((p) => <WorkCard project={p} />)}
    </div>
    <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {others.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>
