---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base
  title="Writing — Mustafa Ekrem KENTER"
  description="Thoughts on agentic AI, MCP, software development, and shipping."
>
  <section class="max-w-3xl mx-auto px-6 pt-14">
    <p class="eyebrow">Writing</p>
    <h1 class="mt-3 text-3xl sm:text-4xl font-bold">
      Notes from the lab.
    </h1>
    <p class="mt-4 text-soft max-w-xl">
      Agentic AI, MCP, and the craft of shipping software.
    </p>
    <ul class="mt-10 divide-y divide-line border-y border-line">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="group block py-5">
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="font-semibold text-lg group-hover:text-accent-strong transition-colors">
                  {post.data.title}
                </h2>
                <time
                  class="font-mono text-xs text-faint shrink-0"
                  datetime={post.data.date.toISOString()}
                >
                  {post.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
              </div>
              {post.data.description && (
                <p class="mt-1 text-sm text-soft">{post.data.description}</p>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
