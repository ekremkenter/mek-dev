---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostFeature from "../../components/PostFeature.astro";
import PostRow from "../../components/PostRow.astro";
import { cv } from "../../lib/cv";
import profile from "../../assets/profile.jpeg";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// the newest post is shown large; the rest are listed by kind
const [latest, ...rest] = posts;
const sections = [
  { title: "Essays", note: "The written form of the talks, and arguments that needed more room.", posts: rest.filter((p) => p.data.kind === "essay") },
  { title: "Research", note: "Long reports, with sources.", posts: rest.filter((p) => p.data.kind === "report") },
  { title: "Notes", note: "Short pieces and working notes.", posts: rest.filter((p) => p.data.kind === "note") },
].filter((s) => s.posts.length > 0);

const talks = cv.speaking
  .filter((s) => s.title)
  .sort((a, b) => (b.date ?? "").localeCompare(a.date ?? ""));
const month = (iso?: string) =>
  iso ? new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", { year: "numeric", month: "short", timeZone: "UTC" }) : "";
---

<Base
  title="Writing & Speaking · Mustafa Ekrem Kenter"
  description="Essays and talks on agentic AI, MCP, chat-native UI, and the craft of shipping software."
>
  <section class="max-w-5xl mx-auto px-6 pt-10 sm:pt-16">
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">Notes from the lab.</h1>
    <p class="mt-4 text-lg text-soft max-w-xl">
      Most of my thinking happens on stage first; the essays are the written form of the talks.
    </p>

    <div class="mt-10 sm:mt-14">
      <PostFeature post={latest} layout="side" />
    </div>
  </section>

  {
    sections.map((section) => (
      <section class="max-w-5xl mx-auto px-6 mt-16 sm:mt-20">
        <div class="page-split">
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold">{section.title}</h2>
            <p class="mt-3 text-soft">{section.note}</p>
          </div>
          <ul class="divide-y divide-line border-y border-line">
            {section.posts.map((post) => (
              <li>
                <PostRow post={post} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="max-w-5xl mx-auto px-6 mt-16 sm:mt-20">
    <div class="page-split">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold">Speaking</h2>
        <p class="mt-3 text-soft">Keynotes, talks and conversations.</p>
      </div>
      <ul class="divide-y divide-line border-y border-line">
        {
          talks.map((t) => (
            <li class="grid gap-x-8 gap-y-1 py-4 sm:grid-cols-[6.5rem_minmax(0,1fr)]">
              <time class="font-mono text-xs text-faint sm:pt-1" datetime={t.date}>
                {month(t.date)}
              </time>
              <div>
                <p class="font-semibold">{t.title}</p>
                <p class="text-sm text-soft">{[t.kind, t.event, t.location].filter(Boolean).join(", ")}</p>
                {(t.essay || t.link) && (
                  <p class="mt-1 flex flex-wrap gap-x-4 text-sm">
                    {t.essay && (
                      <a href={`${t.essay}/`} class="link">
                        Read the essay
                      </a>
                    )}
                    {t.link && (
                      <a href={t.link} target="_blank" rel="noopener" class="link">
                        {t.kind === "Podcast" ? "Listen" : "Watch"}
                      </a>
                    )}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 mt-16 sm:mt-20">
    <div class="home-invite">
      <div class="flex items-center gap-5">
        <Image
          src={profile}
          alt="Mustafa Ekrem Kenter"
          width={160}
          densities={[1, 2]}
          class="rounded-full size-20 object-cover border border-line shrink-0"
        />
        <div>
          <h2 class="text-2xl font-bold">Invite me to speak</h2>
          <p class="mt-2 text-soft max-w-lg">
            Agentic AI and MCP in aviation, chat-native UI, and shipping AI products inside a large enterprise:
            keynotes, panels, and workshops.
          </p>
        </div>
      </div>
      <a
        href={cv.profile.booking}
        target="_blank"
        rel="noopener"
        class="shrink-0 px-6 py-3 rounded-lg bg-accent text-white dark:text-bg font-semibold hover:bg-accent-strong transition-colors"
        >Book 15 minutes</a
      >
    </div>
  </section>
</Base>
