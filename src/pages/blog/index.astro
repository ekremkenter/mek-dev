---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { cv } from "../../lib/cv";
import { readingMinutes } from "../../lib/reading-time";
import profile from "../../assets/profile.jpeg";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const essays = posts.filter((p) => p.data.kind === "essay");
const reports = posts.filter((p) => p.data.kind === "report");
const notes = posts.filter((p) => p.data.kind === "note");
const talks = cv.speaking
  .filter((s) => s.title)
  .sort((a, b) => (b.date ?? "").localeCompare(a.date ?? ""));

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", timeZone: "UTC" });
---

<Base
  title="Writing & Speaking — Mustafa Ekrem Kenter"
  description="Essays and talks on agentic AI, MCP, chat-native UI, and the craft of shipping software."
>
  <section class="max-w-3xl mx-auto px-6 pt-14">
    <p class="eyebrow">Writing &amp; Speaking</p>
    <h1 class="mt-3 text-3xl sm:text-4xl font-bold">Notes from the lab.</h1>
    <p class="mt-4 text-soft max-w-xl">
      Most of my thinking happens on stage first — the essays are the written
      form of the talks.
    </p>

    <h2 class="eyebrow mt-12">Essays</h2>
    <ul class="mt-4 divide-y divide-line border-y border-line">
      {
        essays.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="group block py-5">
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="font-semibold text-lg group-hover:text-accent-strong transition-colors">
                  {post.data.title}
                </h3>
                <time
                  class="font-mono text-xs text-faint shrink-0"
                  datetime={post.data.date.toISOString()}
                >
                  {fmt(post.data.date)}
                </time>
              </div>
              {post.data.description && (
                <p class="mt-1 text-sm text-soft max-w-xl">{post.data.description}</p>
              )}
              {post.data.talk && (
                <p class="mt-1.5 font-mono text-[0.68rem] uppercase tracking-wide text-faint">
                  {post.data.talk}
                </p>
              )}
            </a>
          </li>
        ))
      }
    </ul>

    {
      reports.length > 0 && (
        <>
          <h2 class="eyebrow mt-12">Research</h2>
          <ul class="mt-4 divide-y divide-line border-y border-line">
            {reports.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`} class="group block py-5">
                  <div class="flex items-baseline justify-between gap-4">
                    <h3 class="font-semibold text-lg group-hover:text-accent-strong transition-colors">
                      {post.data.title}
                    </h3>
                    <time
                      class="font-mono text-xs text-faint shrink-0"
                      datetime={post.data.date.toISOString()}
                    >
                      {fmt(post.data.date)}
                    </time>
                  </div>
                  {post.data.description && (
                    <p class="mt-1 text-sm text-soft max-w-xl">{post.data.description}</p>
                  )}
                  <p class="mt-1.5 font-mono text-[0.68rem] uppercase tracking-wide text-faint">
                    Report · {readingMinutes(post.body)} min read
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <h2 class="eyebrow mt-12">Speaking</h2>
    <ul class="mt-4 grid gap-4">
      {
        talks.map((t) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <div>
              <span class="font-medium">“{t.title}”</span>
              <span class="text-soft">
                {` — ${[t.kind, t.event, t.location].filter(Boolean).join(", ")}`}
              </span>
              {t.essay && (
                <a href={`${t.essay}/`} class="link text-sm ml-2">
                  essay ↗
                </a>
              )}
            </div>
            <span class="font-mono text-xs text-faint">{t.year}</span>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 rounded-lg border border-line bg-surface p-5 flex items-center gap-5">
      <Image
        src={profile}
        alt="Mustafa Ekrem Kenter"
        width={128}
        densities={[1, 2]}
        class="rounded-full size-16 object-cover border border-line shrink-0"
      />
      <div>
        <h2 class="font-semibold">Invite me to speak</h2>
        <p class="mt-1 text-sm text-soft max-w-md">
          Agentic AI and MCP in aviation, chat-native UI, and shipping AI
          products inside a large enterprise — keynotes, panels, and workshops.
        </p>
        <a href={cv.profile.booking} target="_blank" rel="noopener" class="link text-sm mt-2 inline-block"
          >Book 15 minutes →</a
        >
      </div>
    </div>

    {
      notes.length > 0 && (
        <>
          <h2 class="eyebrow mt-12">Notes</h2>
          <ul class="mt-4 grid gap-2">
            {notes.map((post) => (
              <li class="flex items-baseline justify-between gap-4">
                <a href={`/blog/${post.id}/`} class="link">
                  {post.data.title}
                </a>
                <time
                  class="font-mono text-xs text-faint shrink-0"
                  datetime={post.data.date.toISOString()}
                >
                  {fmt(post.data.date)}
                </time>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>
</Base>
