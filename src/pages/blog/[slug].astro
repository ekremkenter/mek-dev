---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { readingMinutes } from "../../lib/reading-time";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = post.data.toc ? headings.filter((h) => h.depth === 2) : [];
const isReport = post.data.kind === "report";
const minutes = readingMinutes(post.body);

// an essay and the report behind it link to each other
const paired = post.data.companion ? await getEntry(post.data.companion) : undefined;
if (post.data.companion && !paired) {
  throw new Error(`${post.id}: companion "${post.data.companion.id}" not found`);
}
const companion = paired && !paired.data.draft ? paired : undefined;
const companionLabel =
  companion?.data.kind === "report" ? "The full research report" : "The short version";
const companionMinutes = companion ? readingMinutes(companion.body) : 0;

const fmtLong = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });

const jsonLd = {
  "@context": "https://schema.org",
  "@type": isReport ? "Report" : "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  ...(post.data.updated && { dateModified: post.data.updated.toISOString() }),
  author: {
    "@type": "Person",
    "@id": "https://mek.dev/#person",
    name: "Mustafa Ekrem Kenter",
    url: "https://mek.dev",
  },
  mainEntityOfPage: new URL(`/blog/${post.id}/`, Astro.site).href,
};
---

<Base
  title={`${post.data.title} · Mustafa Ekrem Kenter`}
  description={post.data.description ?? post.data.title}
  ogType="article"
  publishDate={post.data.date}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <article class="max-w-3xl mx-auto px-6 pt-14">
    <p class="eyebrow">
      {isReport && <span>Report · </span>}
      <time datetime={post.data.date.toISOString()}>{fmtLong(post.data.date)}</time>
      <span> · {minutes} min read</span>
    </p>
    {
      post.data.updated && (
        <p class="mt-1 font-mono text-xs text-faint">
          Updated <time datetime={post.data.updated.toISOString()}>{fmtLong(post.data.updated)}</time>
        </p>
      )
    }
    <h1 class="mt-3 text-3xl sm:text-4xl font-bold">{post.data.title}</h1>
    {
      post.data.description && (
        <p class="mt-3 text-soft text-lg">{post.data.description}</p>
      )
    }
    {
      companion && (
        <a href={`/blog/${companion.id}/`} class="callout group mt-8 block">
          <span class="eyebrow">
            {companionLabel} · {companionMinutes} min read
          </span>
          <span class="mt-1 block font-semibold group-hover:text-accent-strong transition-colors">
            {companion.data.title} →
          </span>
        </a>
      )
    }
    {
      toc.length > 0 && (
        <nav aria-label="On this page" class="mt-8 rounded-lg border border-line bg-surface p-4 text-sm">
          <p class="eyebrow mb-2">On this page</p>
          <ul class="grid gap-1">
            {toc.map((h) => (
              <li>
                <a class="link" href={`#${h.slug}`}>
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <div class="prose-mek mt-8">
      <Content />
    </div>
    {
      companion && (
        <a href={`/blog/${companion.id}/`} class="callout group mt-12 block max-w-[42rem]">
          <span class="eyebrow">
            {companionLabel} · {companionMinutes} min read
          </span>
          <span class="mt-1 block font-semibold group-hover:text-accent-strong transition-colors">
            {companion.data.title} →
          </span>
          {companion.data.description && (
            <span class="mt-1 block text-sm text-soft">{companion.data.description}</span>
          )}
        </a>
      )
    }
    <p class="mt-12">
      <a href="/blog/" class="link text-sm">← All writing</a>
    </p>
  </article>
</Base>
