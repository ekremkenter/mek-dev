---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = post.data.toc ? headings.filter((h) => h.depth === 2) : [];
---

<Base
  title={`${post.data.title} — Mustafa Ekrem KENTER`}
  description={post.data.description ?? post.data.title}
>
  <article class="max-w-3xl mx-auto px-6 pt-14">
    <p class="eyebrow">
      <time datetime={post.data.date.toISOString()}>
        {
          post.data.date.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </time>
    </p>
    <h1 class="mt-3 text-3xl sm:text-4xl font-bold">{post.data.title}</h1>
    {
      post.data.description && (
        <p class="mt-3 text-soft text-lg">{post.data.description}</p>
      )
    }
    {
      toc.length > 0 && (
        <nav class="mt-8 rounded-lg border border-line bg-surface p-4 text-sm">
          <p class="eyebrow mb-2">On this page</p>
          <ul class="grid gap-1">
            {toc.map((h) => (
              <li>
                <a class="link" href={`#${h.slug}`}>
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <div class="prose-mek mt-8 [&>h1:first-child]:hidden">
      <Content />
    </div>
    <p class="mt-12">
      <a href="/blog" class="link text-sm">← All writing</a>
    </p>
  </article>
</Base>
