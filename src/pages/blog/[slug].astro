---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = post.data.toc ? headings.filter((h) => h.depth === 2) : [];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: {
    "@type": "Person",
    "@id": "https://mek.dev/#person",
    name: "Mustafa Ekrem Kenter",
    url: "https://mek.dev",
  },
  mainEntityOfPage: new URL(`/blog/${post.id}/`, Astro.site).href,
};
---

<Base
  title={`${post.data.title} — Mustafa Ekrem Kenter`}
  description={post.data.description ?? post.data.title}
  ogType="article"
  publishDate={post.data.date}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <article class="max-w-3xl mx-auto px-6 pt-14">
    <p class="eyebrow">
      <time datetime={post.data.date.toISOString()}>
        {
          post.data.date.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
            timeZone: "UTC",
          })
        }
      </time>
    </p>
    <h1 class="mt-3 text-3xl sm:text-4xl font-bold">{post.data.title}</h1>
    {
      post.data.description && (
        <p class="mt-3 text-soft text-lg">{post.data.description}</p>
      )
    }
    {
      toc.length > 0 && (
        <nav aria-label="On this page" class="mt-8 rounded-lg border border-line bg-surface p-4 text-sm">
          <p class="eyebrow mb-2">On this page</p>
          <ul class="grid gap-1">
            {toc.map((h) => (
              <li>
                <a class="link" href={`#${h.slug}`}>
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <div class="prose-mek mt-8">
      <Content />
    </div>
    <p class="mt-12">
      <a href="/blog/" class="link text-sm">← All writing</a>
    </p>
  </article>
</Base>
