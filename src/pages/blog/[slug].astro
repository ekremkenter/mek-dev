---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { readingMinutes } from "../../lib/reading-time";
import { narrationText, textHash } from "../../lib/narration-text.mjs";
import Listen from "../../components/Listen.astro";
import VideoEmbed from "../../components/VideoEmbed.astro";
import narrations from "../../data/narration.json";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = post.data.toc ? headings.filter((h) => h.depth === 2) : [];
const isReport = post.data.kind === "report";
const minutes = readingMinutes(post.body);

// an essay and the report behind it link to each other
const paired = post.data.companion ? await getEntry(post.data.companion) : undefined;
if (post.data.companion && !paired) {
  throw new Error(`${post.id}: companion "${post.data.companion.id}" not found`);
}
const companion = paired && !paired.data.draft ? paired : undefined;
const companionLabel =
  companion?.data.kind === "report" ? "The full research report" : "The short version";
const companionMinutes = companion ? readingMinutes(companion.body) : 0;

// optional hero art at src/assets/heroes/<post id>.svg, inlined so it follows the theme
const heroes = import.meta.glob<string>("../../assets/heroes/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const hero = heroes[`../../assets/heroes/${post.id}.svg`];

// narration from scripts/tts/narrate.mjs; warn when the text has moved on since
const narration = (narrations as Record<string, { src: string; seconds: number; textHash: string }>)[post.id];
if (narration && narration.textHash !== textHash(narrationText(post.data.title, post.body ?? ""))) {
  console.warn(`[narration] ${post.id}: text changed since the audio was made; run pnpm narrate ${post.id}`);
}

const video = post.data.video;

const fmtLong = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });

const jsonLd = {
  "@context": "https://schema.org",
  "@type": isReport ? "Report" : "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  ...(post.data.updated && { dateModified: post.data.updated.toISOString() }),
  ...(post.data.image && { image: new URL(post.data.image, Astro.site).href }),
  ...(video && {
    video: {
      "@type": "VideoObject",
      name: post.data.title,
      description: post.data.description ?? post.data.title,
      thumbnailUrl: new URL(`/video/${post.id}.jpg`, Astro.site).href,
      uploadDate: video.uploaded.toISOString(),
      duration: `PT${Math.floor(video.seconds / 60)}M${video.seconds % 60}S`,
      embedUrl: `https://www.youtube.com/embed/${video.youtube}`,
      url: `https://www.youtube.com/watch?v=${video.youtube}`,
    },
  }),
  author: {
    "@type": "Person",
    "@id": "https://mek.dev/#person",
    name: "Mustafa Ekrem Kenter",
    url: "https://mek.dev",
  },
  mainEntityOfPage: new URL(`/blog/${post.id}/`, Astro.site).href,
};
---

<Base
  title={`${post.data.title} · Mustafa Ekrem Kenter`}
  description={post.data.description ?? post.data.title}
  ogType="article"
  publishDate={post.data.date}
  ogImage={post.data.image}
  ogImageAlt={post.data.image ? (post.data.imageAlt ?? post.data.title) : undefined}
  ogImageSize={post.data.image ? [1200, 630] : undefined}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <article class="max-w-3xl mx-auto px-6 pt-14">
    <p class="eyebrow">
      {isReport && <span>Report · </span>}
      <time datetime={post.data.date.toISOString()}>{fmtLong(post.data.date)}</time>
      <span> · {minutes} min read</span>
    </p>
    {
      post.data.updated && (
        <p class="mt-1 font-mono text-xs text-faint">
          Updated <time datetime={post.data.updated.toISOString()}>{fmtLong(post.data.updated)}</time>
        </p>
      )
    }
    <h1 class="mt-3 text-3xl sm:text-4xl font-bold">{post.data.title}</h1>
    {
      post.data.description && (
        <p class="mt-3 text-soft text-lg">{post.data.description}</p>
      )
    }
    {narration && <Listen src={narration.src} seconds={narration.seconds} />}
    {
      video ? (
        <VideoEmbed
          id={video.youtube}
          seconds={video.seconds}
          title={post.data.title}
          svg={hero}
          poster={`/video/${post.id}.jpg`}
        />
      ) : (
        hero && <div class="hero no-print mt-8" set:html={hero} />
      )
    }
    {
      companion && (
        <a href={`/blog/${companion.id}/`} class="callout group mt-8 block">
          <span class="eyebrow">
            {companionLabel} · {companionMinutes} min read
          </span>
          <span class="mt-1 block font-semibold group-hover:text-accent-strong transition-colors">
            {companion.data.title} →
          </span>
        </a>
      )
    }
    {
      toc.length > 0 && (
        <nav aria-label="On this page" class="mt-8 rounded-lg border border-line bg-surface p-4 text-sm">
          <p class="eyebrow mb-2">On this page</p>
          <ul class="grid gap-1">
            {toc.map((h) => (
              <li>
                <a class="link" href={`#${h.slug}`}>
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <div class="prose-mek mt-8">
      <Content />
    </div>
    {
      companion && (
        <a href={`/blog/${companion.id}/`} class="callout group mt-12 block max-w-[42rem]">
          <span class="eyebrow">
            {companionLabel} · {companionMinutes} min read
          </span>
          <span class="mt-1 block font-semibold group-hover:text-accent-strong transition-colors">
            {companion.data.title} →
          </span>
          {companion.data.description && (
            <span class="mt-1 block text-sm text-soft">{companion.data.description}</span>
          )}
        </a>
      )
    }
    <p class="no-print mt-12 flex flex-wrap justify-between gap-x-6 gap-y-2 text-sm">
      <a href="/blog/" class="link">← All writing</a>
      <a href={`/ask/?about=${post.id}`} class="link">Ask a question about this {post.data.kind} →</a>
    </p>
  </article>
</Base>
