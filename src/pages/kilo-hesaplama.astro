---
import Base from "../layouts/Base.astro";

const labels = [
  { key: "problem", label: "Aşağısında gözle görülür sorunlar, saçma konuşmalar" },
  { key: "lowCons", label: "Aşağısında bilinç eski performansta değil" },
  { key: "min", label: "İdeal kiloda dip kısım" },
  { key: "max", label: "Üst sınır" },
  { key: "physical", label: "Üstünde gözle görülür sıkıntı" },
];
---

<Base
  title="Kilo Hesaplama · Mustafa Ekrem Kenter"
  description="Boyunuza göre ideal kilo aralığınızı hesaplayın."
  lang="tr"
>
  <section class="max-w-3xl mx-auto px-6 pt-14">
    <p class="eyebrow">Araç</p>
    <h1 class="mt-3 text-3xl sm:text-4xl font-bold">Kilo Hesaplama</h1>
    <p class="mt-4 text-soft">
      İdeal kilonuzu hesaplamak için aşağıya boyunuzu yazınız.
    </p>
    <input
      id="height"
      type="number"
      inputmode="numeric"
      value="180"
      placeholder="Boyunuz (cm)"
      aria-label="Boyunuz (cm)"
      class="mt-6 w-full max-w-xs rounded-md border border-line-strong bg-surface px-4 py-2.5 text-lg font-mono focus:border-accent outline-none"
    />
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-5" aria-live="polite">
      {
        labels.map(({ key, label }) => (
          <div class="rounded-lg border border-line bg-surface p-4">
            <p class="font-mono text-2xl text-accent-strong">
              <span data-value={key}>–</span>
              <span class="text-sm text-faint"> kg</span>
            </p>
            <p class="mt-1 text-sm text-soft">{label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <script>
    const input = document.getElementById("height") as HTMLInputElement;
    const cells =
      document.querySelectorAll<HTMLElement>("[data-value]");

    function calculate(height: number): Record<string, number> {
      const min = (height / 2) * 0.8;
      const max = min * 1.1;
      const physical = max * 1.1;
      const lowCons = min * 0.9;
      const problem = lowCons * 0.9;
      return { problem, lowCons, min, max, physical };
    }

    function render() {
      const height = Math.round(Number(input.value));
      if (!Number.isFinite(height) || height <= 0) {
        cells.forEach((cell) => (cell.textContent = "–"));
        return;
      }
      const values = calculate(height);
      cells.forEach((cell) => {
        cell.textContent = values[cell.dataset.value!]!.toFixed(1);
      });
    }

    input.addEventListener("input", render);
    render();
  </script>
</Base>
