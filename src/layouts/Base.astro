---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/public-sans";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import bricolageWoff2 from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import publicSansWoff2 from "@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Banner from "../components/Banner.astro";

interface Props {
  title: string;
  description: string;
  lang?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  publishDate?: Date;
  noBanner?: boolean;
  noindex?: boolean;
  bare?: boolean;
}

const {
  title,
  description,
  lang = "en",
  ogImage = "/ekrem-kenter-profile.jpeg",
  ogType = "website",
  publishDate,
  noBanner = false,
  noindex = false,
  bare = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Mustafa Ekrem Kenter"
      href="/rss.xml"
    />
    <link rel="preload" as="font" type="font/woff2" href={bricolageWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={publicSansWoff2} crossorigin />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f8f7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e1514" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1775" />
    <meta property="og:image:height" content="1776" />
    <meta property="og:image:alt" content="Portrait of Mustafa Ekrem Kenter" />
    {
      ogType === "article" && publishDate && (
        <meta property="article:published_time" content={publishDate.toISOString()} />
      )
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@ekremkenter" />
    <script is:inline>
      (() => {
        let stored = null;
        let banner = null;
        try {
          stored = localStorage.getItem("theme");
          banner = localStorage.getItem("pal-banner");
        } catch {}
        const theme =
          stored === "light" || stored === "dark"
            ? stored
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.dataset.theme = theme;
        if (banner === "off") document.documentElement.dataset.banner = "off";
      })();
    </script>
    <slot name="head" />
    <!-- Cloudflare Web Analytics (cookieless; auto-injection doesn't apply to
         Worker-served responses, so the beacon is installed manually) -->
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "23d65106bc594eea916bfaae1c372802"}'></script>
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="skip-link no-print">Skip to content</a>
    {!noBanner && <Banner />}
    {!bare && <Nav />}
    <main id="main" class="flex-1 w-full">
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>
