---
import { cv } from "../lib/cv";

const links = [
  { href: "/about/", label: "About" },
  { href: "/projects/", label: "Projects" },
  { href: "/blog/", label: "Writing" },
  { href: "/cv/", label: "CV" },
];
const path = Astro.url.pathname;
---

<header
  class="no-print w-full max-w-3xl mx-auto px-4 sm:px-6 pt-6 pb-2 flex flex-wrap items-center justify-between gap-y-2 gap-x-3"
>
  <a
    href="/"
    class="font-mono text-sm sm:tracking-widest text-ink hover:text-accent-strong transition-colors"
    aria-label="Home">mek.dev</a
  >
  <nav aria-label="Main" class="flex flex-wrap items-center gap-0.5 sm:gap-2 text-[13px] sm:text-sm">
    {
      links.map((l) => (
        <a
          href={l.href}
          aria-current={path.startsWith(l.href.slice(0, -1)) ? "page" : undefined}
          class:list={[
            "px-1.5 sm:px-2.5 py-1.5 rounded-md transition-colors hover:text-accent-strong",
            path.startsWith(l.href.slice(0, -1))
              ? "text-accent-strong font-medium"
              : "text-soft",
          ]}
        >
          {l.label}
        </a>
      ))
    }
    <a
      href={cv.profile.booking}
      target="_blank"
      rel="noopener"
      class="hidden sm:inline-block ml-1 px-3 py-1.5 rounded-md border border-line-strong text-ink hover:border-accent hover:text-accent-strong transition-colors"
      >Let’s talk</a
    >
    <button
      id="theme-toggle"
      type="button"
      class="ml-0.5 sm:ml-1 p-2 rounded-md text-soft hover:text-accent-strong transition-colors"
      aria-label="Switch color theme"
    >
      <svg
        class="size-4 hidden dark:block"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"
        ></path>
      </svg>
      <svg
        class="size-4 dark:hidden"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
      </svg>
    </button>
  </nav>
</header>

<script>
  const toggle = document.getElementById("theme-toggle");
  const sync = () =>
    toggle?.setAttribute(
      "aria-pressed",
      String(document.documentElement.dataset.theme === "dark"),
    );
  sync();
  toggle?.addEventListener("click", () => {
    const next =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
    sync();
  });
</script>
