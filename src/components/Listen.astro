---
// Narration player for a post: play/pause, seek, playback speed. The audio is
// generated by scripts/tts/narrate.mjs and listed in src/data/narration.json.
interface Props {
  src: string;
  seconds: number;
}
const { src, seconds } = Astro.props;
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
const minutes = Math.max(1, Math.round(seconds / 60));
---

<div class="listen no-print mt-8" data-listen>
  <audio preload="none" src={src}></audio>
  <div class="listen-row">
    <button type="button" class="listen-play" aria-label="Play narration" data-play>
      <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"></path></svg>
      <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"></path></svg>
    </button>
    <div class="listen-main">
      <span class="eyebrow">Listen · {minutes} min</span>
      <input
        type="range"
        class="listen-seek"
        min="0"
        max={seconds}
        step="1"
        value="0"
        aria-label="Seek"
        aria-valuetext={`0:00 of ${fmt(seconds)}`}
        data-seek
      />
    </div>
    <span class="listen-time font-mono text-xs text-faint" data-time>0:00 / {fmt(seconds)}</span>
    <button type="button" class="listen-speed font-mono text-xs" aria-label="Playback speed 1×" data-speed>1×</button>
  </div>
  <p class="mt-2 text-xs text-faint">Narrated by an AI clone of my voice.</p>
</div>

<script>
  const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
  const speeds = [1, 1.25, 1.5, 0.75];

  for (const root of document.querySelectorAll<HTMLElement>("[data-listen]")) {
    const audio = root.querySelector("audio")!;
    const play = root.querySelector<HTMLButtonElement>("[data-play]")!;
    const seek = root.querySelector<HTMLInputElement>("[data-seek]")!;
    const time = root.querySelector<HTMLElement>("[data-time]")!;
    const speed = root.querySelector<HTMLButtonElement>("[data-speed]")!;
    let total = Number(seek.max);
    let dragging = false;

    const render = () => {
      const t = audio.currentTime;
      if (!dragging) seek.value = String(t);
      time.textContent = `${fmt(t)} / ${fmt(total)}`;
      seek.setAttribute("aria-valuetext", `${fmt(t)} of ${fmt(total)}`);
      seek.style.setProperty("--progress", `${(t / total) * 100}%`);
    };

    play.addEventListener("click", () => (audio.paused ? audio.play() : audio.pause()));
    audio.addEventListener("play", () => {
      root.dataset.playing = "";
      play.setAttribute("aria-label", "Pause narration");
    });
    audio.addEventListener("pause", () => {
      delete root.dataset.playing;
      play.setAttribute("aria-label", "Play narration");
    });
    audio.addEventListener("loadedmetadata", () => {
      if (Number.isFinite(audio.duration)) {
        total = audio.duration;
        seek.max = String(total);
      }
      render();
    });
    audio.addEventListener("timeupdate", render);
    audio.addEventListener("ended", () => {
      audio.currentTime = 0;
      render();
    });

    seek.addEventListener("input", () => {
      dragging = true;
      time.textContent = `${fmt(Number(seek.value))} / ${fmt(total)}`;
      seek.style.setProperty("--progress", `${(Number(seek.value) / total) * 100}%`);
    });
    seek.addEventListener("change", () => {
      dragging = false;
      audio.currentTime = Number(seek.value);
      render();
    });

    speed.addEventListener("click", () => {
      const next = speeds[(speeds.indexOf(audio.playbackRate) + 1) % speeds.length];
      audio.playbackRate = next;
      speed.textContent = `${next}×`;
      speed.setAttribute("aria-label", `Playback speed ${next}×`);
    });
  }
</script>
