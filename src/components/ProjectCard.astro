---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const href = project.data.href ?? `/projects/${project.id}/`;
---

<a
  href={href}
  class="group flex h-full flex-col rounded-2xl border border-line bg-surface p-6 transition-colors hover:border-accent"
>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="font-semibold text-lg group-hover:text-accent-strong transition-colors">
      {project.data.title}
    </h3>
    <span class="font-mono text-xs text-faint">{project.data.period}</span>
  </div>
  <p class="mt-2 text-sm text-soft leading-relaxed">{project.data.summary}</p>
  <p class="mt-auto pt-4 text-sm text-faint">
    {project.data.role}, {project.data.org}
  </p>
</a>
