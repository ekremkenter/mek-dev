---
// WebMCP: registers the site's read-only agent tools (src/lib/agent-tools.ts)
// with the visitor's browser. They read /agent.json and /agent/<post id>.md on
// demand. Browsers without WebMCP skip all of it.
//
// Chrome origin-trial token for https://mek.dev (not www), feature WebMCP,
// valid until 2027-03-30. Tokens are public by design; renew it before then.
const ORIGIN_TRIAL_TOKEN =
  "AkppUBBpaqkMXJ2iqWE+J/zYBkIFl88pTnNSXK/PXNrzmUs5t+UAKmDc1om8xaS/UBPNG1HiDsCCZVM11pHo/gQAAABHeyJvcmlnaW4iOiJodHRwczovL21lay5kZXY6NDQzIiwiZmVhdHVyZSI6IldlYk1DUCIsImV4cGlyeSI6MTgwNjM2NDgwMH0=";
---

<meta http-equiv="origin-trial" content={ORIGIN_TRIAL_TOKEN} />

<script>
  import { tools, type Index, type Source } from "../lib/agent-tools";

  const mc = (document as any).modelContext ?? (navigator as any).modelContext;

  if (mc?.registerTool) {
    let index: Promise<Index> | undefined;
    const source = (signal?: AbortSignal): Source => ({
      index: () =>
        (index ??= fetch("/agent.json", { signal }).then((r): Promise<Index> => {
          if (!r.ok) throw new Error(`agent.json ${r.status}`);
          return r.json();
        })),
      post: (id) => fetch(`/agent/${id}.md`, { signal }).then((r) => (r.ok ? r.text() : null)),
    });

    for (const { run, title, ...tool } of tools) {
      Promise.resolve(
        mc.registerTool({
          ...tool,
          annotations: { readOnlyHint: true },
          execute: (args: Record<string, any> = {}, { signal }: { signal?: AbortSignal } = {}) =>
            run(args ?? {}, source(signal)),
        }),
      ).catch((err: unknown) => console.warn(`[webmcp] ${tool.name} not registered`, err));
    }
  }
</script>
