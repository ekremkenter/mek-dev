---
import { cv } from "../lib/cv";

const year = new Date().getFullYear();
const s = cv.profile.social;
const socials = [
  { label: "GitHub", href: `https://github.com/${s.github}` },
  { label: "LinkedIn", href: `https://linkedin.com/in/${s.linkedin}` },
  { label: "YouTube", href: `https://www.youtube.com/${s.youtube}` },
  { label: "Twitter", href: `https://twitter.com/${s.twitter}` },
  { label: "Medium", href: `https://medium.com/${s.medium}` },
  { label: "Instagram", href: `https://instagram.com/${s.instagram}` },
  { label: "RSS", href: "/rss.xml" },
];
---

<footer class="no-print w-full max-w-3xl mx-auto px-6 py-10 mt-16 border-t border-line">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <p class="text-sm text-faint font-mono">© {year} Mustafa Ekrem Kenter</p>
    <nav aria-label="Social" class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
      {
        socials.map((l) => (
          <a
            href={l.href}
            target={l.href.startsWith("/") ? undefined : "_blank"}
            rel="noopener"
            class="text-soft hover:text-accent-strong transition-colors"
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
