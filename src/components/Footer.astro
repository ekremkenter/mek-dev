---
const year = new Date().getFullYear();
const socials = [
  { label: "GitHub", href: "https://github.com/ekremkenter" },
  { label: "LinkedIn", href: "https://linkedin.com/in/ekremkenter" },
  { label: "Twitter", href: "https://twitter.com/ekremkenter" },
  { label: "Medium", href: "https://medium.com/@ekremkenter" },
  { label: "Instagram", href: "https://instagram.com/ekremkenter" },
  { label: "RSS", href: "/rss.xml" },
];
---

<footer class="no-print w-full max-w-3xl mx-auto px-6 py-10 mt-16 border-t border-line">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <p class="text-sm text-faint font-mono">
      © {year} Mustafa Ekrem KENTER
    </p>
    <nav class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
      {
        socials.map((s) => (
          <a
            href={s.href}
            target={s.href.startsWith("/") ? undefined : "_blank"}
            rel="noopener"
            class="text-soft hover:text-accent-strong transition-colors"
          >
            {s.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
