{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mek-dev",
  "account_id": "7df993260f5328b7db9d5ce4dfa7edb9",
  "compatibility_date": "2026-08-01",
  "routes": [
    { "pattern": "mek.dev", "custom_domain": true },
    { "pattern": "www.mek.dev", "custom_domain": true }
  ],
  // The Worker handles only these paths (the MCP server and the /ask chat);
  // every other request is served from the assets without running it.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/mcp", "/mcp/", "/api/*"]
  },
  "vars": {
    "CHAT_MODEL": "anthropic/claude-haiku-5.5"
  },
  // OPENROUTER_API_KEY is a secret (wrangler secret put); locally it comes from .env.
  // Per visitor IP. OpenRouter's weekly spending limit caps the rest.
  "ratelimits": [
    { "name": "CHAT_LIMIT", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } },
    { "name": "MCP_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
